<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400"><rect width="600" height="400" fill="#f8f9fa"/><text x="300" y="40" font-family="Arial" font-size="20" fill="#1a73e8" text-anchor="middle">ROS 2 Communication Patterns</text><g transform="translate(100,100)"><circle cx="0" cy="0" r="40" fill="#1a73e8"/><text x="0" y="5" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Node</text><text x="0" y="-55" font-family="Arial" font-size="14" fill="#1a73e8" text-anchor="middle">Publish/Subscribe</text></g><g transform="translate(300,100)"><circle cx="0" cy="-30" r="30" fill="#1a73e8"/><circle cx="0" cy="30" r="30" fill="#4285f4"/><text x="0" y="-50" font-family="Arial" font-size="14" fill="#1a73e8" text-anchor="middle">Request/Response</text></g><g transform="translate(500,100)"><circle cx="0" cy="0" r="40" fill="#4285f4"/><text x="0" y="5" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Action</text><text x="0" y="-55" font-family="Arial" font-size="14" fill="#1a73e8" text-anchor="middle">Goal/Result/Feedback</text></g></svg>
