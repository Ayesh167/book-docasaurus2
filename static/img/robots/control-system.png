<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400"><rect width="600" height="400" fill="#f8f9fa"/><text x="300" y="40" font-family="Arial" font-size="20" fill="#1a73e8" text-anchor="middle">Robot Control System</text><circle cx="100" cy="150" r="30" fill="#4285f4"/><text x="100" y="155" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Goal</text><circle cx="100" cy="250" r="30" fill="#4285f4"/><text x="100" y="255" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">State</text><rect x="300" y="150" width="200" height="100" fill="#1a73e8" rx="10"/><text x="400" y="205" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">PID</text><text x="400" y="225" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Controller</text><circle cx="550" cy="200" r="30" fill="#e91e63"/><text x="550" y="205" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Motor</text><text x="550" y="225" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Commands</text><line x1="130" y1="150" x2="300" y2="180" stroke="#1a73e8" stroke-width="2" marker-end="url(#arrow)"/><line x1="130" y1="250" x2="300" y2="220" stroke="#1a73e8" stroke-width="2" marker-end="url(#arrow)"/><line x1="500" y1="200" x2="520" y2="200" stroke="#e91e63" stroke-width="2" marker-end="url(#arrow)"/><defs><marker id="arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth"><path d="M0,0 L0,6 L9,3 z" fill="#1a73e8"/></marker></defs></svg>
