<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400"><rect width="600" height="400" fill="#f8f9fa"/><text x="300" y="40" font-family="Arial" font-size="20" fill="#1a73e8" text-anchor="middle">Vision System for VLA</text><rect x="100" y="100" width="150" height="100" fill="#ffffff" stroke="#4285f4" stroke-width="2" rx="10"/><text x="175" y="140" font-family="Arial" font-size="14" fill="#4285f4" text-anchor="middle">Camera</text><text x="175" y="160" font-family="Arial" font-size="12" fill="#4285f4" text-anchor="middle">Input</text><circle cx="300" cy="150" r="40" fill="#1a73e8"/><text x="300" y="155" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Object</text><text x="300" y="170" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Detection</text><circle cx="450" cy="150" r="40" fill="#1a73e8"/><text x="450" y="155" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Feature</text><text x="450" y="170" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Extraction</text><circle cx="375" cy="250" r="40" fill="#e91e63"/><text x="375" y="255" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Visual</text><text x="375" y="270" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Output</text><line x1="250" y1="150" x2="260" y2="150" stroke="#1a73e8" stroke-width="2" marker-end="url(#arrow)"/><line x1="340" y1="150" x2="410" y2="150" stroke="#1a73e8" stroke-width="2" marker-end="url(#arrow)"/><line x1="340" y1="180" x2="365" y2="230" stroke="#1a73e8" stroke-width="2" marker-end="url(#arrow)"/><line x1="410" y1="180" x2="385" y2="230" stroke="#1a73e8" stroke-width="2" marker-end="url(#arrow)"/><defs><marker id="arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth"><path d="M0,0 L0,6 L9,3 z" fill="#1a73e8"/></marker></defs></svg>
