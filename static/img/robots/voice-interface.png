<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400"><rect width="600" height="400" fill="#f8f9fa"/><text x="300" y="40" font-family="Arial" font-size="20" fill="#1a73e8" text-anchor="middle">Voice Interface</text><circle cx="150" cy="150" r="50" fill="#4285f4"/><circle cx="150" cy="150" r="30" fill="#ffffff"/><text x="150" y="155" font-family="Arial" font-size="12" fill="#1a73e8" text-anchor="middle">Microphone</text><rect x="300" y="100" width="150" height="100" fill="#1a73e8" rx="10"/><text x="375" y="140" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Speech</text><text x="375" y="160" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Recognition</text><rect x="300" y="250" width="150" height="100" fill="#e91e63" rx="10"/><text x="375" y="290" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Text-to-</text><text x="375" y="310" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Speech</text><line x1="200" y1="150" x2="300" y2="150" stroke="#1a73e8" stroke-width="2" marker-end="url(#arrow)"/><line x1="375" y1="200" x2="375" y2="250" stroke="#e91e63" stroke-width="2" marker-end="url(#arrow)"/><defs><marker id="arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth"><path d="M0,0 L0,6 L9,3 z" fill="#1a73e8"/></marker></defs></svg>
