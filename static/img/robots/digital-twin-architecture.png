<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400"><rect width="600" height="400" fill="#f8f9fa"/><text x="300" y="40" font-family="Arial" font-size="20" fill="#1a73e8" text-anchor="middle">Digital Twin Architecture</text><rect x="100" y="150" width="100" height="150" fill="#1a73e8" rx="10"/><text x="150" y="230" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Physical</text><text x="150" y="250" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Robot</text><rect x="250" y="100" width="100" height="100" fill="#4285f4" rx="10"/><text x="300" y="150" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Simulation</text><rect x="250" y="250" width="100" height="100" fill="#4285f4" rx="10"/><text x="300" y="300" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Data Sync</text><rect x="400" y="150" width="100" height="150" fill="#1a73e8" rx="10"/><text x="450" y="230" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Validation</text><text x="450" y="250" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Tools</text><line x1="200" y1="225" x2="250" y2="150" stroke="#1a73e8" stroke-width="2" marker-end="url(#arrow)"/><line x1="200" y1="225" x2="250" y2="300" stroke="#1a73e8" stroke-width="2" marker-end="url(#arrow)"/><line x1="350" y1="150" x2="400" y2="225" stroke="#1a73e8" stroke-width="2" marker-end="url(#arrow)"/><line x1="350" y1="300" x2="400" y2="225" stroke="#1a73e8" stroke-width="2" marker-end="url(#arrow)"/><defs><marker id="arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth"><path d="M0,0 L0,6 L9,3 z" fill="#1a73e8"/></marker></defs></svg>
