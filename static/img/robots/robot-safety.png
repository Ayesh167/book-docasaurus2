<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400"><rect width="600" height="400" fill="#f8f9fa"/><text x="300" y="40" font-family="Arial" font-size="20" fill="#1a73e8" text-anchor="middle">Robot Safety Systems</text><rect x="150" y="100" width="300" height="200" fill="#ffffff" stroke="#e91e63" stroke-width="3" rx="15"/><text x="300" y="150" font-family="Arial" font-size="18" fill="#e91e63" text-anchor="middle">SAFETY</text><text x="300" y="180" font-family="Arial" font-size="16" fill="#1a73e8" text-anchor="middle">LIMITS</text><circle cx="180" cy="250" r="15" fill="#4caf50"/><circle cx="300" cy="250" r="15" fill="#ff9800"/><circle cx="420" cy="250" r="15" fill="#f44336"/><text x="180" y="275" font-family="Arial" font-size="12" fill="#000" text-anchor="middle">OK</text><text x="300" y="275" font-family="Arial" font-size="12" fill="#000" text-anchor="middle">WARN</text><text x="420" y="275" font-family="Arial" font-size="12" fill="#000" text-anchor="middle">STOP</text></svg>
