<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400"><rect width="600" height="400" fill="#f8f9fa"/><text x="300" y="40" font-family="Arial" font-size="20" fill="#1a73e8" text-anchor="middle">VLA System Components</text><rect x="100" y="100" width="120" height="80" fill="#4285f4" rx="10"/><text x="160" y="140" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Vision</text><text x="160" y="160" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">System</text><rect x="240" y="100" width="120" height="80" fill="#4285f4" rx="10"/><text x="300" y="140" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Language</text><text x="300" y="160" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Processor</text><rect x="380" y="100" width="120" height="80" fill="#4285f4" rx="10"/><text x="440" y="140" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Action</text><text x="440" y="160" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Executor</text><rect x="200" y="250" width="200" height="80" fill="#1a73e8" rx="10"/><text x="300" y="285" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Integration</text><text x="300" y="305" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Engine</text><line x1="160" y1="180" x2="300" y2="250" stroke="#1a73e8" stroke-width="2" stroke-dasharray="5,5" marker-end="url(#arrow)"/><line x1="300" y1="180" x2="300" y2="250" stroke="#1a73e8" stroke-width="2" stroke-dasharray="5,5" marker-end="url(#arrow)"/><line x1="440" y1="180" x2="300" y2="250" stroke="#1a73e8" stroke-width="2" stroke-dasharray="5,5" marker-end="url(#arrow)"/><defs><marker id="arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth"><path d="M0,0 L0,6 L9,3 z" fill="#1a73e8"/></marker></defs></svg>
