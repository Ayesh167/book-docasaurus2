<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400"><rect width="600" height="400" fill="#f8f9fa"/><text x="300" y="40" font-family="Arial" font-size="20" fill="#1a73e8" text-anchor="middle">Robot Perception System</text><circle cx="100" cy="100" r="30" fill="#4285f4"/><text x="100" y="105" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Camera</text><circle cx="100" cy="200" r="30" fill="#4285f4"/><text x="100" y="205" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">LIDAR</text><circle cx="100" cy="300" r="30" fill="#4285f4"/><text x="100" y="305" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">IMU</text><rect x="300" y="150" width="200" height="100" fill="#1a73e8" rx="10"/><text x="400" y="205" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Perception</text><text x="400" y="225" font-family="Arial" font-size="14" fill="#ffffff" text-anchor="middle">Engine</text><line x1="130" y1="100" x2="300" y2="180" stroke="#1a73e8" stroke-width="2" marker-end="url(#arrow)"/><line x1="130" y1="200" x2="300" y2="200" stroke="#1a73e8" stroke-width="2" marker-end="url(#arrow)"/><line x1="130" y1="300" x2="300" y2="220" stroke="#1a73e8" stroke-width="2" marker-end="url(#arrow)"/><defs><marker id="arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth"><path d="M0,0 L0,6 L9,3 z" fill="#1a73e8"/></marker></defs></svg>
