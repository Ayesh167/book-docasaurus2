<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400"><rect width="600" height="400" fill="#f8f9fa"/><text x="300" y="40" font-family="Arial" font-size="20" fill="#1a73e8" text-anchor="middle">Human-Robot Interaction</text><circle cx="150" cy="150" r="50" fill="#4285f4"/><text x="150" y="155" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Human</text><circle cx="450" cy="150" r="50" fill="#1a73e8"/><text x="450" y="155" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Robot</text><path d="M200,150 Q300,100 400,150" stroke="#1a73e8" stroke-width="3" fill="none" stroke-dasharray="5,5"/><text x="300" y="90" font-family="Arial" font-size="14" fill="#1a73e8" text-anchor="middle">Natural Language</text><path d="M200,150 Q300,200 400,150" stroke="#4285f4" stroke-width="3" fill="none" stroke-dasharray="5,5"/><text x="300" y="220" font-family="Arial" font-size="14" fill="#4285f4" text-anchor="middle">Visual Feedback</text><circle cx="150" cy="300" r="30" fill="#e91e63"/><text x="150" y="305" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Voice</text><circle cx="450" cy="300" r="30" fill="#e91e63"/><text x="450" y="305" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Action</text><line x1="150" y1="200" x2="150" y2="270" stroke="#e91e63" stroke-width="2" marker-end="url(#arrow)"/><line x1="450" y1="200" x2="450" y2="270" stroke="#e91e63" stroke-width="2" marker-end="url(#arrow)"/><defs><marker id="arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth"><path d="M0,0 L0,6 L9,3 z" fill="#e91e63"/></marker></defs></svg>
